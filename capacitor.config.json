{
  "appId": "com.teamops.app",
  "appName": "WSX OS",
  "webDir": "dist/app",
  "backgroundColor": "#FFFFFF",
  "ios": {
    "contentInset": "never",
    "scheme": "TeamOps",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "banner",
        "list"
      ]
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true
  }
}
