{
  "name": "team-ops",
  "version": "0.7.0",
  "private": true,
  "description": "团队协同 App：网页 / iOS（Capacitor）客户端 + 零依赖 Node 服务器",
  "scripts": {
    "build": "node build.js",
    "dev": "node scripts/dev.js",
    "test": "node test.js && node test_sync.js && node test_fuzz.js 3000 7 && node test_fuzz.js 3000 2026 && node test_server.js && node test_ai.js && node test_ai_local.js && node test_push.js && node test_transcribe.js",
    "e2e": "node scripts/e2e.js",
    "check": "npm run build && npm test && npm run e2e",
    "setup": "npx playwright install chromium",
    "server": "node server/server.js",
    "ios": "node build.js && npx cap copy ios && node scripts/ios.js",
    "crawl": "node scripts/e2e.js crawl",
    "android": "node scripts/android.js",
    "test:android": "node e2e/device_android.js",
    "test:ios": "node e2e/device_ios.js",
    "test:android:flow": "node e2e/device_android_flow.js",
    "test:ios:flow": "node e2e/device_ios_flow.js"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "playwright": "1.56.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "qrcode-generator": "^1.5.2"
  }
}
